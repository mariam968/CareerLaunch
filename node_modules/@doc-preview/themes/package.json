{
  "name": "@doc-preview/themes",
  "version": "1.2.0",
  "description": "CSS themes for Doc Preview.",
  "type": "module",
  "style": "./src/doc-preview.css",
  "exports": {
    ".": "./src/doc-preview.css",
    "./doc-preview.css": "./src/doc-preview.css"
  },
  "files": ["src", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkishorsahu89/doc-preview.git",
    "directory": "packages/themes"
  },
  "bugs": "https://github.com/rajkishorsahu89/doc-preview/issues",
  "homepage": "https://doc-preview-app.vercel.app/",
  "author": "Rajkishor Sahu (https://github.com/rajkishorsahu89/)",
  "scripts": {
    "build": "node -e \"console.log('themes: css ready')\"",
    "prepack": "node ../../scripts/assert-pack-ready.mjs"
  },
  "keywords": ["doc-preview", "css", "theme", "document-viewer"],
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
