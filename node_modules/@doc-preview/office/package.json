{
  "name": "@doc-preview/office",
  "version": "1.2.0",
  "description": "Optional Office format renderers (XLSX, PPTX/ODP slide decks, legacy Office, cloud viewer).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkishorsahu89/doc-preview.git",
    "directory": "packages/office"
  },
  "bugs": "https://github.com/rajkishorsahu89/doc-preview/issues",
  "homepage": "https://doc-preview-app.vercel.app/",
  "author": "Rajkishor Sahu (https://github.com/rajkishorsahu89/)",
  "scripts": {
    "bundle:word-ole": "node scripts/bundle-word-ole.mjs",
    "build": "npm run bundle:word-ole && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/assert-pack-ready.mjs"
  },
  "dependencies": {
    "@doc-preview/core": "^1.1.3",
    "buffer": "^6.0.3",
    "cfb": "^1.2.2",
    "jszip": "^3.10.1",
    "officeparser": "^7.1.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@doc-preview/core": "^1.1.3"
  },
  "keywords": [
    "doc-preview",
    "office",
    "xlsx",
    "spreadsheet",
    "ppt",
    "doc"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
