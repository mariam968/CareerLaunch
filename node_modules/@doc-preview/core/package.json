{
  "name": "@doc-preview/core",
  "version": "1.2.0",
  "description": "Framework-neutral document preview engine, renderer registry, and DOM rendering.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajkishorsahu89/doc-preview.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/rajkishorsahu89/doc-preview/issues",
  "homepage": "https://doc-preview-app.vercel.app/",
  "author": "Rajkishor Sahu (https://github.com/rajkishorsahu89/)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/assert-pack-ready.mjs"
  },
  "keywords": [
    "doc-preview",
    "document-viewer",
    "file-preview",
    "pdf",
    "typescript",
    "renderer-registry"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.11",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "jsdom": "^29.1.1"
  }
}
